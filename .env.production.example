# BACKUP_ALERT_EMAIL ustaw dopiero po pierwszej udanej kopii (deploy-ovh.md, krok 7 kopii).
BACKUP_SLOTS=00:00,11:00,16:30
BACKUP_ALERT_EMAIL=
