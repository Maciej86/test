# Skopiuj ten plik jako .env. Plik .env nigdy nie trafia na GitHub.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=app
DB_PASSWORD=zmien_mnie_lokalnie
DB_NAME=app
MYSQL_ROOT_PASSWORD=zmien_mnie_root
# Wygeneruje /stepkit:start
JWT_SECRET=
PORT=3006
# Hasło stałych kont testowych e2e.<rola>@test.local (wpisuje je Claude, losowe)
# E2E_PASSWORD=
FRONTEND_URL=http://localhost:5180
# Zmień, jeśli inny program zajmuje te porty na Twoim komputerze:
FRONTEND_PORT=5180
MOCKUPS_PORT=5181
# PHPMYADMIN_PORT=8080

# E-maile. Lokalnie łapie je skrzynka testowa Mailpit (http://localhost:8025), nikt ich naprawdę nie dostaje.
# Prawdziwa wysyłka (Mailgun) w module Publikacja: zmieniają się tylko te linie.
EMAIL_TRANSPORT=mailpit
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@localhost
# Port podglądu skrzynki testowej, gdy 8025 jest zajęty:
# MAILPIT_PORT=8026
