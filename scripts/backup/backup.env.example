# Plik NA SERWERZE: ~/backup.env (prawa 600). Poza katalogiem aplikacji i nigdy niepodpięty do kontenerów aplikacji.
# Klucz tajny S3 (AWS_SECRET_ACCESS_KEY) wpisuje właściciel sam w edytorze przez ssh, nigdy w rozmowie.
# Bez cudzysłowów: plik czyta też `docker run --env-file`.
BACKUP_LOCAL_DIR=/home/app/backups
BACKUP_AGE_PUBLIC_KEY=age1...
BACKUP_S3_ENDPOINT=https://s3.de.io.cloud.ovh.net
BACKUP_S3_REGION=de
BACKUP_S3_BUCKET=nazwa-projektu-kopie
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
