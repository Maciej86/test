# Kopia zapasowa bazy i plików: scripts/backup/backup.sh. Instalacja: deploy-ovh.md, „Kopie zapasowe poza serwerem”.
# Ścieżki zakładają konto `app` i aplikację w /home/app/app (jak w deploy-ovh.md).
[Unit]
Description=Kopia zapasowa aplikacji (baza i pliki)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=app
Group=app
Environment=HOME=/home/app
WorkingDirectory=/home/app/app
# Pliki kopii i log czytelne tylko dla konta app.
UMask=0077
PrivateTmp=true
ExecStart=/home/app/app/scripts/backup/backup.sh
Nice=10
IOSchedulingClass=idle
